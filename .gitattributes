# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts should always use LF
*.sh text eol=lf

# SQL scripts should use LF
*.sql text eol=lf

# Batch files should use CRLF (Windows)
*.bat text eol=crlf
*.cmd text eol=crlf

# Docker files should use LF
Dockerfile text eol=lf
docker-compose.yml text eol=lf
.dockerignore text eol=lf

# C# source files
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=lf

# Config files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.xml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.dll binary
*.exe binary
